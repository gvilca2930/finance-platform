generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum WorkspaceType {
  PERSONAL
  BUSINESS
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  STAFF
  VIEWER
}

enum WorkspaceMemberStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum FinancialAccountType {
  CASH
  BANK
  DIGITAL_WALLET
  SAVINGS
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique @db.VarChar(320)
  passwordHash  String     @map("password_hash") @db.VarChar(255)
  emailVerified Boolean    @default(false) @map("email_verified")
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(3)

  profile      UserProfile?
  memberships  WorkspaceMember[]
  authSessions AuthSession[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("users")
}

model UserProfile {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  firstName        String    @map("first_name") @db.VarChar(100)
  middleName       String?   @map("middle_name") @db.VarChar(100)
  paternalLastName String    @map("paternal_last_name") @db.VarChar(100)
  maternalLastName String?   @map("maternal_last_name") @db.VarChar(100)
  documentType     String?   @map("document_type") @db.VarChar(30)
  documentNumber   String?   @map("document_number") @db.VarChar(50)
  phone            String?   @db.VarChar(30)
  secondaryPhone   String?   @map("secondary_phone") @db.VarChar(30)
  birthDate        DateTime? @map("birth_date") @db.Date
  countryCode      String    @default("PE") @map("country_code") @db.Char(2)
  department       String?   @db.VarChar(100)
  province         String?   @db.VarChar(100)
  district         String?   @db.VarChar(100)
  addressLine1     String?   @map("address_line_1") @db.VarChar(200)
  addressLine2     String?   @map("address_line_2") @db.VarChar(200)
  postalCode       String?   @map("postal_code") @db.VarChar(20)
  timezone         String    @default("America/Lima") @db.VarChar(64)
  preferredCurrency String  @default("PEN") @map("preferred_currency") @db.Char(3)
  language         String    @default("es") @db.VarChar(10)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("user_profiles")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([createdAt])
  @@map("auth_sessions")
}

model Workspace {
  id           String          @id @default(uuid()) @db.Uuid
  name         String          @db.VarChar(150)
  type         WorkspaceType
  currencyCode String          @default("PEN") @map("currency_code") @db.Char(3)
  countryCode  String          @default("PE") @map("country_code") @db.Char(2)
  timezone     String          @default("America/Lima") @db.VarChar(64)
  description  String?         @db.VarChar(500)
  status       WorkspaceStatus @default(ACTIVE)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?       @map("deleted_at") @db.Timestamptz(3)

  businessProfile      BusinessProfile?
  members              WorkspaceMember[]
  invitations          WorkspaceInvitation[]
  accounts             FinancialAccount[]
  categories           Category[]
  transactions         Transaction[]
  transfers            Transfer[]
  budgets              Budget[]
  recurringTransactions RecurringTransaction[]
  accountAccesses      FinancialAccountAccess[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("workspaces")
}

model BusinessProfile {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @unique @map("workspace_id") @db.Uuid
  legalName    String   @map("legal_name") @db.VarChar(200)
  tradeName    String?  @map("trade_name") @db.VarChar(200)
  taxId        String?  @map("tax_id") @db.VarChar(50)
  email        String?  @db.VarChar(320)
  phone        String?  @db.VarChar(30)
  website      String?  @db.VarChar(255)
  countryCode  String   @default("PE") @map("country_code") @db.Char(2)
  department   String?  @db.VarChar(100)
  province     String?  @db.VarChar(100)
  district     String?  @db.VarChar(100)
  addressLine1 String?  @map("address_line_1") @db.VarChar(200)
  addressLine2 String?  @map("address_line_2") @db.VarChar(200)
  postalCode   String?  @map("postal_code") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([taxId])
  @@index([createdAt])
  @@map("business_profiles")
}

model WorkspaceMember {
  id          String                @id @default(uuid()) @db.Uuid
  workspaceId String                @map("workspace_id") @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  role        WorkspaceRole
  status      WorkspaceMemberStatus @default(ACTIVE)
  joinedAt    DateTime              @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace            Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user                 User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitationsCreated   WorkspaceInvitation[]      @relation("InvitationsCreatedBy")
  transactionsCreated  Transaction[]              @relation("TransactionsCreatedBy")
  transfersCreated     Transfer[]                 @relation("TransfersCreatedBy")
  recurringCreated     RecurringTransaction[]     @relation("RecurringCreatedBy")
  accountAccesses      FinancialAccountAccess[]

  @@unique([workspaceId, userId])
  @@index([workspaceId, status, role])
  @@index([userId, status])
  @@index([createdAt])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  email           String           @db.VarChar(320)
  role            WorkspaceRole
  tokenHash       String           @unique @map("token_hash") @db.VarChar(255)
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(3)
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  acceptedAt      DateTime?        @map("accepted_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  invitedBy WorkspaceMember @relation("InvitationsCreatedBy", fields: [workspaceId, invitedByUserId], references: [workspaceId, userId], onDelete: Restrict)

  @@index([workspaceId, status, expiresAt])
  @@index([email, status])
  @@index([invitedByUserId])
  @@index([createdAt])
  @@map("workspace_invitations")
}

model FinancialAccount {
  id             String               @id @default(uuid()) @db.Uuid
  workspaceId    String               @map("workspace_id") @db.Uuid
  name           String               @db.VarChar(150)
  type           FinancialAccountType
  currencyCode   String               @default("PEN") @map("currency_code") @db.Char(3)
  initialBalance Decimal              @default(0) @map("initial_balance") @db.Decimal(14, 2)
  description    String?              @db.VarChar(500)
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?            @map("deleted_at") @db.Timestamptz(3)

  workspace            Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  transactions         Transaction[]
  outgoingTransfers    Transfer[]                 @relation("TransferSource")
  incomingTransfers    Transfer[]                 @relation("TransferDestination")
  recurringTransactions RecurringTransaction[]
  memberAccesses       FinancialAccountAccess[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, id, currencyCode])
  @@index([workspaceId, active, createdAt])
  @@index([createdAt])
  @@map("financial_accounts")
}

model FinancialAccountAccess {
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  member    WorkspaceMember  @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)
  account   FinancialAccount @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)

  @@id([workspaceId, userId, accountId])
  @@index([accountId])
  @@index([userId])
  @@index([createdAt])
  @@map("financial_account_accesses")
}

model Category {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  name        String       @db.VarChar(120)
  type        CategoryType
  parentId    String?      @map("parent_id") @db.Uuid
  icon        String?      @db.VarChar(80)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(3)

  workspace            Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  parent               Category?              @relation("CategoryTree", fields: [workspaceId, parentId], references: [workspaceId, id], onDelete: Restrict)
  children             Category[]             @relation("CategoryTree")
  transactions         Transaction[]
  budgets              Budget[]
  recurringTransactions RecurringTransaction[]

  @@unique([workspaceId, id])
  @@index([workspaceId, type, active])
  @@index([workspaceId, parentId])
  @@index([createdAt])
  @@map("categories")
}

model Transaction {
  id              String          @id @default(uuid()) @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  accountId       String          @map("account_id") @db.Uuid
  categoryId      String          @map("category_id") @db.Uuid
  createdByUserId String          @map("created_by_user_id") @db.Uuid
  type            TransactionType
  amount          Decimal         @db.Decimal(14, 2)
  currencyCode    String          @map("currency_code") @db.Char(3)
  transactionDate DateTime        @map("transaction_date") @db.Date
  description     String          @db.VarChar(250)
  notes           String?         @db.VarChar(1000)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(3)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  account   FinancialAccount @relation(fields: [workspaceId, accountId, currencyCode], references: [workspaceId, id, currencyCode], onDelete: Restrict)
  category  Category         @relation(fields: [workspaceId, categoryId], references: [workspaceId, id], onDelete: Restrict)
  createdBy WorkspaceMember  @relation("TransactionsCreatedBy", fields: [workspaceId, createdByUserId], references: [workspaceId, userId], onDelete: Restrict)

  @@index([workspaceId, transactionDate(sort: Desc), createdAt(sort: Desc)])
  @@index([workspaceId, type, transactionDate(sort: Desc)])
  @@index([workspaceId, accountId, transactionDate(sort: Desc)])
  @@index([workspaceId, categoryId, transactionDate(sort: Desc)])
  @@index([workspaceId, createdByUserId, transactionDate(sort: Desc)])
  @@index([accountId])
  @@index([categoryId])
  @@index([createdByUserId])
  @@index([createdAt])
  @@map("transactions")
}

model Transfer {
  id                   String    @id @default(uuid()) @db.Uuid
  workspaceId          String    @map("workspace_id") @db.Uuid
  sourceAccountId      String    @map("source_account_id") @db.Uuid
  destinationAccountId String    @map("destination_account_id") @db.Uuid
  amount               Decimal   @db.Decimal(14, 2)
  currencyCode         String    @map("currency_code") @db.Char(3)
  transactionDate      DateTime  @map("transaction_date") @db.Date
  description          String?   @db.VarChar(250)
  createdByUserId      String    @map("created_by_user_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sourceAccount      FinancialAccount @relation("TransferSource", fields: [workspaceId, sourceAccountId, currencyCode], references: [workspaceId, id, currencyCode], onDelete: Restrict)
  destinationAccount FinancialAccount @relation("TransferDestination", fields: [workspaceId, destinationAccountId, currencyCode], references: [workspaceId, id, currencyCode], onDelete: Restrict)
  createdBy          WorkspaceMember  @relation("TransfersCreatedBy", fields: [workspaceId, createdByUserId], references: [workspaceId, userId], onDelete: Restrict)

  @@index([workspaceId, transactionDate(sort: Desc), createdAt(sort: Desc)])
  @@index([workspaceId, sourceAccountId, transactionDate(sort: Desc)])
  @@index([workspaceId, destinationAccountId, transactionDate(sort: Desc)])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([createdByUserId])
  @@index([createdAt])
  @@map("transfers")
}

model Budget {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  categoryId      String    @map("category_id") @db.Uuid
  amount          Decimal   @db.Decimal(14, 2)
  month           Int       @db.SmallInt
  year            Int       @db.SmallInt
  alertPercentage Decimal?  @map("alert_percentage") @db.Decimal(5, 2)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  category  Category  @relation(fields: [workspaceId, categoryId], references: [workspaceId, id], onDelete: Restrict)

  @@index([workspaceId, year, month])
  @@index([workspaceId, categoryId, year, month])
  @@index([categoryId])
  @@index([createdAt])
  @@map("budgets")
}

model RecurringTransaction {
  id                String              @id @default(uuid()) @db.Uuid
  workspaceId       String              @map("workspace_id") @db.Uuid
  accountId         String              @map("account_id") @db.Uuid
  categoryId        String              @map("category_id") @db.Uuid
  type              TransactionType
  amount            Decimal             @db.Decimal(14, 2)
  frequency         RecurrenceFrequency
  startDate         DateTime            @map("start_date") @db.Date
  nextExecutionDate DateTime            @map("next_execution_date") @db.Date
  description       String              @db.VarChar(250)
  active            Boolean             @default(true)
  createdByUserId   String              @map("created_by_user_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  account   FinancialAccount @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Restrict)
  category  Category         @relation(fields: [workspaceId, categoryId], references: [workspaceId, id], onDelete: Restrict)
  createdBy WorkspaceMember  @relation("RecurringCreatedBy", fields: [workspaceId, createdByUserId], references: [workspaceId, userId], onDelete: Restrict)

  @@index([workspaceId, active, nextExecutionDate])
  @@index([workspaceId, accountId])
  @@index([workspaceId, categoryId])
  @@index([accountId])
  @@index([categoryId])
  @@index([createdByUserId])
  @@index([createdAt])
  @@map("recurring_transactions")
}
