NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://finance_user:change_me_with_a_strong_local_password@localhost:5432/finance_db?schema=public

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters_access
JWT_REFRESH_SECRET=replace_with_at_least_32_random_characters_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGINS=http://localhost:3000,http://localhost:8081
SWAGGER_ENABLED=true
